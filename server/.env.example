# Cloudinary → Settings → API Keys → "API environment variable"
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Cloudinary AI add-ons (enable their free plans under Add-ons). They run after each upload;
# one that is not enabled is skipped and shown in the app, uploads never fail because of it.
# Google Auto Tagging
CLD_TAGGING=true
# Cloudinary AI Content Analysis: image captions
CLD_CAPTIONING=true
# Cloudinary AI Vision: our restoration activity tags (dry lakebed, desilting, saplings planted...)
CLD_AI_VISION=true
# Index photos for Cloudinary visual search
CLD_VISUAL_SEARCH=true

# Media Library folder for everything GreenProof stores
GP_FOLDER=greenproof

# Optional team key (header X-Editor-Key): when set, only the team can open and change projects.
# Public report links never need it. Leave empty for an open app.
EDITOR_KEY=
